# RON — Real or Not · env template (placeholders only — never commit real keys)
# Copy to .env / .env.local and fill in. The app runs fully offline on the
# 5 ground-truth fixtures when these are unset.

# Convex real-time backend (auto-written to .env.local by `npx convex dev`)
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Modal GPU backend (AudioSeal + SigLIP-2) — printed by `modal deploy`
MODAL_ENDPOINT_URL=https://your-workspace--ron-real-or-not-backend-analyze-media-endpoint.modal.run
PUBLIC_MODAL_ENDPOINT=https://your-workspace--ron-real-or-not-backend-analyze-media-endpoint.modal.run

# Webhook gate for the Modal endpoint (create via `modal secret create ron-webhook ...`).
# The PUBLIC_ copy lets browser-direct PiP calls authenticate (scanner deterrence).
MODAL_WEBHOOK_SECRET=ron_change_me
PUBLIC_MODAL_WEBHOOK_SECRET=ron_change_me

# Meta Model API (dev.meta.ai → API Keys; free $150 hackathon credits, no card needed)
# Never prefix secrets with PUBLIC_ — keep server-only.
META_API_KEY=your_meta_model_api_key_here

# Hosted Muse Spark Open token (only if calling meta-models/muse-spark-open-1026
# via a partner/hosted endpoint instead of Modal + Meta only)
OPENROUTER_OR_MODAL_SPARK_OPEN_KEY=
